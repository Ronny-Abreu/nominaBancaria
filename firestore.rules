rules_version = '2';

// Almost every write below is `allow write: if false` on purpose: privileged
// mutations happen server-side through the Firebase Admin SDK (which bypasses
// these rules entirely) inside role-checked Next.js API routes. These rules
// exist to gate direct CLIENT-SIDE reads (used by onSnapshot for the live
// employee table and payroll status UI) plus one narrow self-service update.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function callerRol() {
      return isSignedIn() ? callerDoc().data.rol : null;
    }

    function isAdmin() {
      return callerRol() == 'admin';
    }

    function isRrhhOrAdmin() {
      return callerRol() == 'rrhh' || callerRol() == 'admin';
    }

    match /usuarios/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isRrhhOrAdmin());

      // Self-service: an authenticated user may only flip mustChangePassword
      // (and bump updatedAt) on their own doc after completing the forced
      // first-login password change. Everything else is Admin-SDK-only.
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['mustChangePassword', 'updatedAt']);

      allow create, delete: if false;
    }

    match /nominaRuns/{runId} {
      allow read: if isRrhhOrAdmin();
      allow write: if false;

      match /items/{itemId} {
        allow read: if isRrhhOrAdmin();
        allow write: if false;
      }
    }

    // Registro inmutable de auditoría (AB-100): lectura solo admin; ninguna
    // escritura/edición/eliminación desde el cliente. Los inserts ocurren solo
    // vía Admin SDK en rutas API, y el código nunca hace update/delete aquí.
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Parámetros fiscales (AB-79/AB-138): cualquier usuario autenticado puede
    // leerlos (los usa el motor de cálculo); solo Admin SDK escribe.
    match /configuracion/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Marcadores de idempotencia de pago (AB-150): lectura rrhh/admin; solo
    // Admin SDK los crea al confirmarse un pago exitoso.
    match /pagosRealizados/{id} {
      allow read: if isRrhhOrAdmin();
      allow write: if false;
    }

    // Contadores internos (p.ej. secuencia de código de empleado): nunca
    // accedidos desde el cliente, solo por Admin SDK dentro de transacciones.
    match /counters/{id} {
      allow read, write: if false;
    }
  }
}
